{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "r2-video-upload-backend",

  "main": "src/index.ts",

  "compatibility_date": "2026-08-09",

  "workers_dev": true,

  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "anime-videos"
    }
  ],

  "vars": {
    "R2_ACCOUNT_ID": "95312ac85dee066a389d6297e82a678b",
    "R2_BUCKET_NAME": "anime-videos",
    "ALLOWED_ORIGIN": "*"
  }
}
